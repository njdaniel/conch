# Binaries
/conch
/conchd
/bin/
/dist/

# Rust (voice/). What a build produces for this checkout; it is per-checkout
# on purpose, so that no two worktrees build into the same directory
# (scripts/voice-env.sh).
/voice/target/

# Web client (web/). npm ci installs node_modules from package-lock.json, which
# is committed; dist is what `make web-build` produces for conchd --web-dir.
/web/node_modules/
/web/dist/

# Desktop shell (desktop/). node_modules is installed by npm ci; out/ is what
# `make desktop-build` bundles (main, preload, the web client, the asset
# manifest) and dist/ the unpacked app electron-builder makes from it.
/desktop/node_modules/
/desktop/out/
/desktop/dist/
/desktop/test-results/

# The copy of web/dist that conchd embeds (-tags conchweb); `make web-embed`
# makes it.
/internal/web/dist/

# Go
*.test
*.out
coverage.*

# SQLite
*.db
*.db-wal
*.db-shm

# Environment / local config
.env
.env.*

# Editor
.idea/
.vscode/
*.swp

# Browser suite output (web/e2e, issue #285): traces of failed tests.
/web/test-results/
