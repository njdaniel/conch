{
  "name": "conch-desktop",
  "version": "0.0.0",
  "private": true,
  "description": "The Conch desktop shell: Electron hosting the packaged web client (ADR-007)",
  "license": "AGPL-3.0-only",
  "author": "Conch contributors",
  "type": "module",
  "main": "out/main/main.cjs",
  "desktopName": "chat.conch.desktop.desktop",
  "engines": {
    "node": "24.21.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests/smoke",
    "typecheck:e2e": "tsc --noEmit -p tests/e2e",
    "lint:e2e": "DESKTOP_LINT_E2E_PAGE=1 eslint --max-warnings 0 tests/e2e/page",
    "lint": "eslint --max-warnings 0 .",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "smoke": "playwright test",
    "bundle": "vite build --config vite.main.config.ts && vite build --config vite.preload.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.61.0",
    "electron": "44.10.0",
    "electron-builder": "26.17.0",
    "eslint": "10.12.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
