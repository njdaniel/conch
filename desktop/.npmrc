# Refuse to install with a Node other than the one package.json's engines pins.
engine-strict=true
# No package runs code when it is installed: what runs is what the build and
# the tests run, and nothing else.
ignore-scripts=true
# Should someone add a dependency, it is written as an exact version, which
# scripts/web-depgate.sh requires.
save-exact=true
fund=false
