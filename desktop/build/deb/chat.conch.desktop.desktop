[Desktop Entry]
Type=Application
Version=1.5
Name=Conch
GenericName=Chat
Comment=Chat with your Conch server
Exec=conch-desktop %U
Icon=chat.conch.desktop
Terminal=false
Categories=Network;InstantMessaging;
# The one URL scheme the app takes (issue #1592): conch://invite?server=...&code=...
MimeType=x-scheme-handler/conch;
StartupWMClass=conch-desktop
StartupNotify=true
