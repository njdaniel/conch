#!/bin/sh
# Reloads the AppArmor profile and refreshes the desktop and icon caches. It
# changes nothing else: no group, no udev rule, no capability (issue #1597).
# Every step is best effort; a missing tool or an older AppArmor never fails
# the install.
set -e

case "$1" in
configure)
    profile=/etc/apparmor.d/conch-desktop
    if [ -f "$profile" ] && [ -d /sys/kernel/security/apparmor ] && command -v apparmor_parser >/dev/null 2>&1; then
        apparmor_parser -r -T -W "$profile" ||
            echo "conch-desktop: could not load $profile; where unprivileged user namespaces are restricted the app will not start (see docs)" >&2
    fi
    if command -v update-desktop-database >/dev/null 2>&1; then
        update-desktop-database -q /usr/share/applications || true
    fi
    if command -v gtk-update-icon-cache >/dev/null 2>&1; then
        gtk-update-icon-cache -q -t -f /usr/share/icons/hicolor || true
    fi
    ;;
esac

exit 0
