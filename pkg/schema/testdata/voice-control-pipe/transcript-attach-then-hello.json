{
  "description": "A helper started with --events-pipe: its first line on the events endpoint is the attach line, read by the owner with ParseVoiceControlPipeAttached and matched against the nonce it put in the helper's environment; its second is the unchanged v1 hello (seq 1), and from there the connection is the control protocol. The owner dies while the helper is still starting: standard input ends and the helper stops with owner_lost, never having opened a device. Step 1 is read by the attach reader; every later step by the control readers, by who wrote it.",
  "steps": [
    {
      "from": "helper",
      "message": {
        "schema": "conch.voice_control_pipe.v1",
        "kind": "attached",
        "nonce": "FAKE_nonce_do_not_print_0123456789abcdefghA"
      }
    },
    {
      "from": "helper",
      "message": {
        "schema": "conch.voice_control.v1",
        "kind": "hello",
        "seq": 1,
        "versions": [
          "conch.voice_control.v1"
        ],
        "helper_version": "0.1.0 (48000 Hz, 10 ms frames)"
      }
    },
    {
      "from": "owner",
      "message": {
        "schema": "conch.voice_control.v1",
        "kind": "start",
        "id": 1,
        "server": "https://conch.example.org",
        "channel": "general",
        "principal_id": 7,
        "credential": "env",
        "muted": false,
        "deafened": false
      }
    },
    {
      "from": "helper",
      "message": {
        "schema": "conch.voice_control.v1",
        "kind": "state",
        "seq": 2,
        "phase": "starting",
        "capture": "off",
        "transmitting": false,
        "muted": false,
        "deafened": false,
        "blocked": [
          "not_connected",
          "no_publish_grant",
          "no_microphone"
        ],
        "ptt": "unknown"
      }
    },
    {
      "from": "helper",
      "message": {
        "schema": "conch.voice_control.v1",
        "kind": "ack",
        "seq": 3,
        "id": 1,
        "ok": true
      }
    },
    {
      "from": "owner",
      "close": "stdin"
    },
    {
      "from": "helper",
      "message": {
        "schema": "conch.voice_control.v1",
        "kind": "state",
        "seq": 4,
        "phase": "stopping",
        "reason": "owner_lost",
        "capture": "off",
        "transmitting": false,
        "muted": false,
        "deafened": false,
        "blocked": [
          "not_connected",
          "no_publish_grant",
          "no_microphone"
        ],
        "ptt": "unknown"
      }
    },
    {
      "from": "helper",
      "message": {
        "schema": "conch.voice_control.v1",
        "kind": "state",
        "seq": 5,
        "phase": "stopped",
        "reason": "owner_lost",
        "capture": "off",
        "transmitting": false,
        "muted": false,
        "deafened": false,
        "blocked": [
          "not_connected",
          "no_publish_grant",
          "no_microphone"
        ],
        "ptt": "unknown"
      }
    },
    {
      "from": "helper",
      "exit": 0
    }
  ]
}
