{
  "description": "Conformance cases for the v4 start destination: a channel or a private call attempt, exactly one. The forms and results are those of voice-control/cases.json. TestVoiceControlV4IsV3 also runs the v3 conformance cases through the v4 readers with processing added to state.",
  "cases": [
    {
      "name": "start naming a channel",
      "direction": "command",
      "line": "{\"schema\":\"conch.voice_control.v4\",\"kind\":\"start\",\"id\":1,\"server\":\"https://conch.example.org\",\"channel\":\"general\",\"principal_id\":7,\"credential\":\"stored\",\"muted\":false,\"deafened\":false}",
      "want": {
        "result": "accept",
        "kind": "start"
      }
    },
    {
      "name": "start naming a canonical call attempt ID",
      "direction": "command",
      "line": "{\"schema\":\"conch.voice_control.v4\",\"kind\":\"start\",\"id\":1,\"server\":\"https://conch.example.org\",\"call\":\"k3Jx9dQ0mT7vB2nYw5LcRg\",\"principal_id\":7,\"credential\":\"stored\",\"muted\":false,\"deafened\":false}",
      "want": {
        "result": "accept",
        "kind": "start"
      }
    },
    {
      "name": "start naming a call with the old minimum length",
      "direction": "command",
      "line": "{\"schema\":\"conch.voice_control.v4\",\"kind\":\"start\",\"id\":1,\"server\":\"https://conch.example.org\",\"call\":\"aaaaaaaaaaaaaaaa\",\"principal_id\":7,\"credential\":\"stored\",\"muted\":false,\"deafened\":false}",
      "want": {
        "result": "refuse",
        "code": "invalid",
        "id": 1
      }
    },
    {
      "name": "start naming a call with the old maximum length",
      "direction": "command",
      "line": "{\"schema\":\"conch.voice_control.v4\",\"kind\":\"start\",\"id\":1,\"server\":\"https://conch.example.org\",\"call\":\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"principal_id\":7,\"credential\":\"stored\",\"muted\":false,\"deafened\":false}",
      "want": {
        "result": "refuse",
        "code": "invalid",
        "id": 1
      }
    },
    {
      "name": "start with a bearer credential as the call",
      "direction": "command",
      "line": "{\"schema\":\"conch.voice_control.v4\",\"kind\":\"start\",\"id\":1,\"server\":\"https://conch.example.org\",\"call\":\"conch_AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA\",\"principal_id\":7,\"credential\":\"stored\",\"muted\":false,\"deafened\":false}",
      "want": {
        "result": "refuse",
        "code": "invalid",
        "id": 1
      }
    },
