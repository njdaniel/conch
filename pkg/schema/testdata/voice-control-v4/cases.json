      "line": "{\"schema\":\"conch.voice_control.v4\",\"kind\":\"start\",\"id\":1,\"server\":\"https://conch.example.org\",\"call\":\"k3Jx9dQ0mT7vB2nYw5LcRh\",\"principal_id\":7,\"credential\":\"stored\",\"muted\":false,\"deafened\":false}",
      "want": {
        "result": "refuse",
        "code": "invalid",
        "id": 1
      }
