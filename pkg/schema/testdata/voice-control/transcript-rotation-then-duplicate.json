{
  "description": "The room is rotated (the helper asks conchd again at once and rejoins on its own), then the same account joins voice from elsewhere: the helper stops and does not try again.",
  "steps": [
    {
      "from": "helper",
      "message": {
        "schema": "conch.voice_control.v1",
        "kind": "hello",
        "seq": 1,
        "versions": [
          "conch.voice_control.v1"
        ],
        "helper_version": "0.1.0 (48000 Hz, 10 ms frames)"
      }
    },
    {
      "from": "owner",
      "message": {
        "schema": "conch.voice_control.v1",
        "kind": "start",
        "id": 1,
        "server": "https://conch.example.org",
        "channel": "general",
        "principal_id": 7,
        "credential": "stored",
        "muted": false,
        "deafened": false
      }
    },
    {
      "from": "helper",
      "message": {
        "schema": "conch.voice_control.v1",
        "kind": "state",
        "seq": 2,
        "phase": "starting",
        "capture": "off",
        "transmitting": false,
        "muted": false,
        "deafened": false,
        "blocked": [
          "not_connected",
          "no_publish_grant",
          "no_microphone"
        ],
        "ptt": "unknown"
      }
    },
    {
      "from": "helper",
      "message": {
        "schema": "conch.voice_control.v1",
        "kind": "ack",
        "seq": 3,
        "id": 1,
        "ok": true
      }
    },
    {
      "from": "helper",
      "message": {
        "schema": "conch.voice_control.v1",
        "kind": "state",
        "seq": 4,
        "phase": "connecting",
        "capture": "off",
        "transmitting": false,
        "muted": false,
        "deafened": false,
        "blocked": [
          "not_connected",
          "no_publish_grant",
          "no_microphone"
        ],
        "ptt": "ready"
      }
    },
    {
      "from": "helper",
      "message": {
        "schema": "conch.voice_control.v1",
        "kind": "state",
        "seq": 5,
        "phase": "connected",
        "capture": "on",
        "transmitting": false,
        "muted": false,
        "deafened": false,
        "blocked": [],
        "ptt": "ready"
      }
    },
    {
      "from": "helper",
      "message": {
        "schema": "conch.voice_control.v1",
        "kind": "state",
        "seq": 6,
        "phase": "reconnecting",
        "reason": "room_deleted",
        "retry_in_ms": 0,
        "capture": "on",
        "transmitting": false,
        "muted": false,
        "deafened": false,
        "blocked": [
          "not_connected"
        ],
        "ptt": "ready"
      }
    },
    {
      "from": "helper",
      "message": {
        "schema": "conch.voice_control.v1",
        "kind": "state",
        "seq": 7,
        "phase": "connecting",
        "capture": "on",
        "transmitting": false,
        "muted": false,
        "deafened": false,
        "blocked": [
          "not_connected"
        ],
        "ptt": "ready"
      }
    },
    {
      "from": "helper",
      "message": {
        "schema": "conch.voice_control.v1",
        "kind": "state",
        "seq": 8,
        "phase": "connected",
        "capture": "on",
        "transmitting": false,
        "muted": false,
        "deafened": false,
        "blocked": [],
        "ptt": "ready"
      }
    },
    {
      "from": "helper",
      "message": {
        "schema": "conch.voice_control.v1",
        "kind": "state",
        "seq": 9,
        "phase": "stopping",
        "reason": "duplicate_identity",
        "capture": "on",
        "transmitting": false,
        "muted": false,
        "deafened": false,
        "blocked": [
          "not_connected"
        ],
        "ptt": "ready"
      }
    },
    {
      "from": "helper",
      "message": {
        "schema": "conch.voice_control.v1",
        "kind": "state",
        "seq": 10,
        "phase": "failed",
        "reason": "duplicate_identity",
        "capture": "off",
        "transmitting": false,
        "muted": false,
        "deafened": false,
        "blocked": [
          "not_connected"
        ],
        "ptt": "ready"
      }
    },
    {
      "from": "helper",
      "exit": 1
    }
  ]
}
