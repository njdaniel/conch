{
  "description": "Conformance cases for the two readers: direction command is the helper reading the owner's lines (ParseVoiceControlCommand), direction event is the owner reading the helper's (ParseVoiceControlEvent). Each case is one line, given by line (text), line_hex (bytes) or line_file (a file under this directory holding the line with no line feed). want.result is accept (with the kind read, and for a hello whether it offers v1), refuse (with the code, and the id when the line had a usable one) or skip (an event of a kind this version does not know, which a reader ignores).",
  "cases": [
    {
      "name": "set_mute",
      "direction": "command",
      "line": "{\"schema\":\"conch.voice_control.v1\",\"kind\":\"set_mute\",\"id\":7,\"muted\":true}",
      "want": {
        "result": "accept",
        "kind": "set_mute"
      }
    },
    {
      "name": "start, stored login",
      "direction": "command",
      "line": "{\"schema\":\"conch.voice_control.v1\",\"kind\":\"start\",\"id\":1,\"server\":\"https://conch.example.org\",\"channel\":\"general\",\"principal_id\":7,\"credential\":\"stored\",\"muted\":false,\"deafened\":false}",
      "want": {
        "result": "accept",
        "kind": "start"
      }
    },
    {
      "name": "start, CONCH_TOKEN login",
      "direction": "command",
      "line": "{\"schema\":\"conch.voice_control.v1\",\"kind\":\"start\",\"id\":1,\"server\":\"http://127.0.0.1:8080\",\"channel\":\"general\",\"principal_id\":7,\"credential\":\"env\",\"muted\":false,\"deafened\":false}",
      "want": {
        "result": "accept",
        "kind": "start"
      }
    },
    {
      "name": "start at a server under a path",
      "direction": "command",
      "line": "{\"schema\":\"conch.voice_control.v1\",\"kind\":\"start\",\"id\":1,\"server\":\"https://example.org/conch\",\"channel\":\"general\",\"principal_id\":7,\"credential\":\"stored\",\"muted\":false,\"deafened\":false}",
      "want": {
        "result": "accept",
        "kind": "start"
      }
    },
    {
      "name": "start with a field it does not declare, named token: ignored, and never repeated",
      "direction": "command",
      "line": "{\"schema\":\"conch.voice_control.v1\",\"kind\":\"start\",\"id\":1,\"server\":\"https://conch.example.org\",\"channel\":\"general\",\"principal_id\":7,\"credential\":\"stored\",\"muted\":false,\"deafened\":false,\"token\":\"conch_FAKE_login_token_do_not_print\"}",
      "want": {
        "result": "accept",
        "kind": "start"
      }
    },
    {
      "name": "white space around the object, carriage return included",
      "direction": "command",
      "line": " {\"schema\":\"conch.voice_control.v1\",\"kind\":\"set_mute\",\"id\":7,\"muted\":true} \r",
      "want": {
        "result": "accept",
        "kind": "set_mute"
      }
    },
    {
      "name": "exactly the longest line",
      "direction": "command",
      "line_file": "lines/command-at-limit.txt",
      "want": {
        "result": "accept",
        "kind": "get_state"
      }
    },
    {
      "name": "one byte longer than the longest line",
      "direction": "command",
      "line_file": "lines/command-too-long.txt",
      "want": {
        "result": "refuse",
        "code": "too_long"
      }
    },
    {
      "name": "the largest id",
      "direction": "command",
      "line": "{\"schema\":\"conch.voice_control.v1\",\"kind\":\"get_state\",\"id\":9007199254740991}",
      "want": {
        "result": "accept",
        "kind": "get_state"
      }
    },
    {
      "name": "not JSON: a standalone line command",
      "direction": "command",
      "line": "leave",
      "want": {
        "result": "refuse",
        "code": "malformed"
      }
    },
    {
      "name": "an empty line",
      "direction": "command",
      "line": "",
      "want": {
        "result": "refuse",
        "code": "malformed"
      }
    },
    {
      "name": "a JSON array",
      "direction": "command",
