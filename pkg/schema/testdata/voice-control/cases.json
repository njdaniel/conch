      "want": {
        "result": "refuse",
        "code": "malformed"
      }
    },
    {
      "name": "two objects on one line",
      "direction": "command",
      "line": "{\"schema\":\"conch.voice_control.v1\",\"kind\":\"set_mute\",\"id\":7,\"muted\":true}{\"schema\":\"conch.voice_control.v1\",\"kind\":\"set_mute\",\"id\":7,\"muted\":true}",
