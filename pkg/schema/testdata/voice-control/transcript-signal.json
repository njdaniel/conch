{
  "description": "The helper is sent SIGTERM (the supervisor's escalation): it leaves as for leave, with reason signal.",
  "steps": [
    {
      "from": "helper",
      "message": {
        "schema": "conch.voice_control.v1",
        "kind": "hello",
        "seq": 1,
        "versions": [
          "conch.voice_control.v1"
        ],
        "helper_version": "0.1.0 (48000 Hz, 10 ms frames)"
      }
    },
    {
      "from": "owner",
      "message": {
        "schema": "conch.voice_control.v1",
        "kind": "start",
        "id": 1,
        "server": "https://conch.example.org",
        "channel": "general",
        "principal_id": 7,
        "credential": "stored",
        "muted": false,
        "deafened": false
      }
    },
    {
      "from": "helper",
      "message": {
        "schema": "conch.voice_control.v1",
        "kind": "state",
        "seq": 2,
        "phase": "starting",
        "capture": "off",
        "transmitting": false,
        "muted": false,
        "deafened": false,
        "blocked": [
          "not_connected",
          "no_publish_grant",
          "no_microphone"
        ],
        "ptt": "unknown"
      }
    },
    {
      "from": "helper",
      "message": {
        "schema": "conch.voice_control.v1",
        "kind": "ack",
        "seq": 3,
        "id": 1,
        "ok": true
      }
    },
    {
      "from": "helper",
      "message": {
        "schema": "conch.voice_control.v1",
        "kind": "state",
        "seq": 4,
        "phase": "connecting",
        "capture": "off",
        "transmitting": false,
        "muted": false,
        "deafened": false,
        "blocked": [
          "not_connected",
          "no_publish_grant",
          "no_microphone"
        ],
        "ptt": "ready"
      }
    },
    {
      "from": "helper",
      "message": {
        "schema": "conch.voice_control.v1",
        "kind": "state",
        "seq": 5,
        "phase": "connected",
        "capture": "on",
        "transmitting": false,
        "muted": false,
        "deafened": false,
        "blocked": [],
        "ptt": "ready"
      }
    },
    {
      "from": "owner",
      "signal": "SIGTERM"
    },
    {
      "from": "helper",
      "message": {
        "schema": "conch.voice_control.v1",
        "kind": "state",
        "seq": 6,
        "phase": "stopping",
        "reason": "signal",
        "capture": "on",
        "transmitting": false,
        "muted": false,
        "deafened": false,
        "blocked": [
          "not_connected"
        ],
        "ptt": "ready"
      }
    },
    {
      "from": "helper",
      "message": {
        "schema": "conch.voice_control.v1",
        "kind": "state",
        "seq": 7,
        "phase": "stopped",
        "reason": "signal",
        "capture": "off",
        "transmitting": false,
        "muted": false,
        "deafened": false,
        "blocked": [
          "not_connected"
        ],
        "ptt": "ready"
      }
    },
    {
      "from": "helper",
      "exit": 0
    }
  ]
}
