{
  "description": "The helper offers v1 and v2 in its v1 hello; the owner picks v2 by writing its start in v2, and every later line of either side is v2. The states carry playback and talk_mode; the talk mode is push_to_talk in starting, before the configuration is read, and here voice.toml leaves it so.",
  "steps": [
    {
      "from": "helper",
      "message": {
        "schema": "conch.voice_control.v1",
        "kind": "hello",
        "seq": 1,
        "versions": [
          "conch.voice_control.v1",
          "conch.voice_control.v2"
        ],
        "helper_version": "0.2.0 (48000 Hz, 10 ms frames)"
      }
    },
    {
      "from": "owner",
      "message": {
        "schema": "conch.voice_control.v2",
        "kind": "start",
        "id": 1,
        "server": "https://conch.example.org",
        "channel": "general",
        "principal_id": 7,
        "credential": "stored",
        "muted": false,
        "deafened": false
      }
    },
    {
      "from": "helper",
      "message": {
        "schema": "conch.voice_control.v2",
        "kind": "state",
        "seq": 2,
        "phase": "starting",
        "capture": "off",
        "playback": "off",
        "transmitting": false,
        "muted": false,
        "deafened": false,
        "blocked": [
          "not_connected",
          "no_publish_grant",
          "no_microphone"
        ],
        "talk_mode": "push_to_talk",
        "ptt": "unknown"
      }
    },
    {
      "from": "helper",
      "message": {
        "schema": "conch.voice_control.v2",
        "kind": "ack",
        "seq": 3,
        "id": 1,
        "ok": true
      }
    },
    {
      "from": "helper",
      "message": {
        "schema": "conch.voice_control.v2",
        "kind": "state",
        "seq": 4,
        "phase": "connecting",
        "capture": "off",
        "playback": "on",
        "transmitting": false,
        "muted": false,
        "deafened": false,
        "blocked": [
          "not_connected",
          "no_publish_grant",
          "no_microphone"
        ],
        "talk_mode": "push_to_talk",
        "ptt": "ready"
      }
    },
    {
      "from": "helper",
      "message": {
        "schema": "conch.voice_control.v2",
        "kind": "state",
        "seq": 5,
        "phase": "connected",
        "capture": "on",
        "playback": "on",
        "transmitting": false,
        "muted": false,
        "deafened": false,
        "blocked": [],
        "talk_mode": "push_to_talk",
        "ptt": "ready"
      }
    },
    {
      "from": "owner",
      "message": {
        "schema": "conch.voice_control.v2",
        "kind": "get_state",
        "id": 2
      }
    },
    {
      "from": "helper",
      "message": {
        "schema": "conch.voice_control.v2",
        "kind": "state",
        "seq": 6,
        "phase": "connected",
        "capture": "on",
        "playback": "on",
        "transmitting": false,
        "muted": false,
        "deafened": false,
        "blocked": [],
        "talk_mode": "push_to_talk",
        "ptt": "ready"
      }
    },
    {
      "from": "helper",
      "message": {
        "schema": "conch.voice_control.v2",
        "kind": "ack",
        "seq": 7,
        "id": 2,
        "ok": true
      }
    },
    {
      "from": "owner",
      "message": {
        "schema": "conch.voice_control.v2",
        "kind": "leave",
        "id": 3
      }
    },
    {
      "from": "helper",
      "message": {
        "schema": "conch.voice_control.v2",
        "kind": "state",
        "seq": 8,
        "phase": "stopping",
        "reason": "left",
        "capture": "on",
        "playback": "on",
        "transmitting": false,
        "muted": false,
        "deafened": false,
        "blocked": [
          "not_connected"
        ],
        "talk_mode": "push_to_talk",
        "ptt": "ready"
      }
    },
    {
      "from": "helper",
      "message": {
        "schema": "conch.voice_control.v2",
        "kind": "ack",
        "seq": 9,
        "id": 3,
        "ok": true
      }
    },
    {
      "from": "owner",
      "close": "stdin"
    },
    {
      "from": "helper",
      "message": {
        "schema": "conch.voice_control.v2",
        "kind": "state",
        "seq": 10,
        "phase": "stopped",
        "reason": "left",
        "capture": "off",
        "playback": "off",
        "transmitting": false,
        "muted": false,
        "deafened": false,
        "blocked": [
          "not_connected"
        ],
        "talk_mode": "push_to_talk",
        "ptt": "ready"
      }
    },
    {
      "from": "helper",
      "exit": 0
    }
  ]
}
