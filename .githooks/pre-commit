#!/usr/bin/env bash
# Conch pre-commit hook: the local copy of the deterministic enforcement layer.
# CI (.github/workflows/ci.yml) runs the same checks remotely.
# Install with: make hooks-install
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

echo "pre-commit: gofmt"
unformatted=$(gofmt -l .)
if [ -n "$unformatted" ]; then
    echo "gofmt needed on:"
    echo "$unformatted"
    exit 1
fi

echo "pre-commit: go vet"
go vet ./...

echo "pre-commit: golangci-lint"
if command -v golangci-lint >/dev/null 2>&1; then
    ./scripts/lint-version.sh # must be the version CI runs (.golangci-lint-version)
    golangci-lint run
else
    echo "warning: golangci-lint not installed locally — CI will enforce it" >&2
fi

echo "pre-commit: go test"
go test ./...

echo "pre-commit: schema compatibility"
./scripts/schema-compat.sh

echo "pre-commit: dependency gate"
./scripts/depgate.sh

# The hook that runs may belong to another checkout (core.hooksPath can be an
# absolute path shared by every worktree), so it can be newer than the branch
# being committed. A branch from before voice/ existed has no Rust leg to run.
# Where the script exists it always runs, and fails if its toolchain is missing.
if [ -f ./scripts/rust-check.sh ]; then
    echo "pre-commit: rust (voice/)"
    bash ./scripts/rust-check.sh
fi

echo "pre-commit: OK"
