[Unit]
Description=Run the Conch principal review once a week

[Timer]
# Monday morning, two hours before conch-agent's first run of the day: the
# two share a lock, and the review should have it first.
OnCalendar=Mon *-*-* 07:00:00
RandomizedDelaySec=10min
Persistent=true

[Install]
WantedBy=timers.target
