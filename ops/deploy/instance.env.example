# Settings for one conchd instance. Copy to /etc/conch/<instance>.env and
# edit; every value below is a placeholder. The file holds a secret (the
# LiveKit key pair), so it must be mode 0600 and owned by root:
#
#   install -m 0600 -o root -g root instance.env.example /etc/conch/alpha.env
#
# systemd reads it as root, so the service user does not need to. Never put
# a value from this file in a unit file, a Caddyfile, a command line or the
# repository. The format is KEY=value, one per line, no quotes.

# Where this instance keeps conch.db and files/. Must be
# /var/lib/conch/<instance>: that is the directory conchd@.service creates,
# lets the service write and the backup script reads.
CONCHD_DATA=/var/lib/conch/alpha

# Loopback only: Caddy is the public face. Give every instance its own port.
CONCHD_LISTEN=127.0.0.1:8080

# The address clients are given for voice: the public LiveKit name Caddy
# serves (docs/deploy.md), not the loopback one.
CONCHD_LIVEKIT_URL=wss://livekit.example.com
# The address conchd itself calls for room control: LiveKit on this host.
CONCHD_LIVEKIT_API_URL=http://127.0.0.1:7880
# Start of every voice room this instance creates. Lower-case letters,
# digits and '-', at most 32 characters, ending in '-'. One per instance.
CONCHD_LIVEKIT_ROOM_PREFIX=alpha-

# This instance's own LiveKit key pair, one pair per instance. Generate with
#   openssl rand -hex 8      for the key
#   openssl rand -hex 32     for the secret
# and add the same pair, as a line "<key>: <secret>", to LiveKit's key file
# (/etc/conch/livekit-keys). Use a different pair for every instance.
CONCHD_LIVEKIT_API_KEY=replace-with-a-key
CONCHD_LIVEKIT_API_SECRET=replace-with-a-long-random-secret

# Trusted-proxy setting (issue A6b): when that lands, set it here to the
# loopback address Caddy connects from. Left out until then.
# CONCHD_TRUSTED_PROXY=
