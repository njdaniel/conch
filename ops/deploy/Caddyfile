# Public TLS for a Conch droplet. Caddy gets and renews a certificate for
# every name below on its own (ports 80 and 443 must be open, and each name
# must already resolve to this host). `reverse_proxy` keeps the Host header
# the client sent and passes WebSocket upgrades, which is what conchd's
# same-origin check needs (README, "Optional: TLS and a reverse proxy").
#
# example.com is a placeholder. Replace it everywhere before use:
#   sed -i 's/example\.com/your.domain/g' /etc/caddy/Caddyfile
# Check it with: caddy validate --config /etc/caddy/Caddyfile
# Apply it with: systemctl reload caddy

{
	# Where Let's Encrypt writes if a certificate cannot be renewed.
	email admin@example.com

	# Caddy's admin API has no authentication. On its default address
	# (localhost:2019) any local process, conchd and LiveKit included, could
	# rewrite the proxy configuration. A unix socket in Caddy's own state
	# directory is reachable only by the caddy user (and root). The packaged
	# `systemctl reload caddy` (`caddy reload --config ... --force`) reads this
	# address from the Caddyfile, so reloading still works.
	admin unix//var/lib/caddy/admin.sock
}

# One block per instance: <instance>.<domain> -> that instance's loopback
# port (CONCHD_LISTEN in /etc/conch/<instance>.env).
alpha.example.com {
	header Strict-Transport-Security "max-age=31536000"
	reverse_proxy 127.0.0.1:8080
}

# A second instance is one more block:
# beta.example.com {
# 	header Strict-Transport-Security "max-age=31536000"
# 	reverse_proxy 127.0.0.1:8081
# }

# LiveKit signalling (its port 7880 stays on loopback). Only the client
# signalling path is public; LiveKit's server API (/twirp) is for conchd,
# which calls it on loopback, so everything else is answered 404 here.
livekit.example.com {
	handle /rtc* {
		reverse_proxy 127.0.0.1:7880
	}
	handle {
		respond 404
	}
}

# The name LiveKit's TURN server answers on. LiveKit speaks TURN/TLS itself
# on its own port; this block exists so Caddy obtains and renews the
# certificate for the name. LiveKit reads it from Caddy's storage
# (livekit.service, livekit-cert.path). The issuer is pinned to ACME (Let's
# Encrypt) so the certificate stays in the one directory those units name:
# with Caddy's default issuers a fallback to another CA would move it.
turn.example.com {
	tls {
		issuer acme
	}
	respond "" 204
}
