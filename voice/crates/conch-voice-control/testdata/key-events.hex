# Key events for the decoder's tests (src/keys.rs), written by hand to the
# format of Linux's `struct input_event` on a 64-bit system.
#
# THIS IS NOT A RECORDING. No keyboard was read to make this file, and none
# ever may be: a recording of a keyboard is someone's keystrokes. To change
# it, edit the values by hand.
#
# One record per line, 24 bytes, little-endian, as hex:
#
#   seconds (8)      microseconds (8) type code value
#
# Spaces are ignored and `#` starts a comment. The times are made up: record
# n has second n and microsecond n, except where a comment says otherwise.
# Types: 00 EV_SYN, 01 EV_KEY, 02 EV_REL, 04 EV_MSC, 11 EV_LED.
# Key values: 1 press, 0 release, 2 auto-repeat.
#
# The tests bind talk = KEY_RIGHTCTRL (97, 0x61), mute = KEY_F13 (183, 0xb7)
# and deafen = KEY_F14 (184, 0xb8). Lines marked `=>` are the only ones that
# may come out of the decoder; everything else must be discarded.
0100000000000000 0100000000000000 0400 0400 04000700  #  1: MSC_SCAN: another event type
0200000000000000 0200000000000000 0100 1e00 01000000  #  2: KEY_A press: another key
0300000000000000 0300000000000000 0000 0000 00000000  #  3: SYN_REPORT
0400000000000000 0400000000000000 0400 0400 04000700  #  4: MSC_SCAN
0500000000000000 0500000000000000 0100 1e00 00000000  #  5: KEY_A release: another key
0600000000000000 0600000000000000 0000 0000 00000000  #  6: SYN_REPORT
0700000000000000 0700000000000000 0100 2a00 01000000  #  7: KEY_LEFTSHIFT press: another key, held across the talk press
0800000000000000 0800000000000000 0000 0000 00000000  #  8: SYN_REPORT
0900000000000000 0900000000000000 0400 0400 61000000  #  9: MSC_SCAN whose value is the talk code: not a key event
0a00000000000000 0a00000000000000 0100 6100 01000000  # 10: => talk press
0b00000000000000 0b00000000000000 0000 0000 00000000  # 11: SYN_REPORT
0c00000000000000 0c00000000000000 0100 6100 02000000  # 12: talk auto-repeat: ignored
0d00000000000000 0d00000000000000 0000 0000 00000000  # 13: SYN_REPORT
0e00000000000000 0e00000000000000 0100 6100 02000000  # 14: talk auto-repeat: ignored
0f00000000000000 0f00000000000000 0000 0000 00000000  # 15: SYN_REPORT
1000000000000000 1000000000000000 0100 3000 01000000  # 16: KEY_B press while talk is held: another key
1100000000000000 1100000000000000 0000 0000 00000000  # 17: SYN_REPORT
1200000000000000 1200000000000000 0100 3000 00000000  # 18: KEY_B release: another key
1300000000000000 1300000000000000 0000 0000 00000000  # 19: SYN_REPORT
1400000000000000 1400000000000000 0100 b700 01000000  # 20: => mute press
1500000000000000 1500000000000000 0000 0000 00000000  # 21: SYN_REPORT
1600000000000000 1600000000000000 0100 b700 00000000  # 22: => mute release
1700000000000000 1700000000000000 0000 0000 00000000  # 23: SYN_REPORT
1800000000000000 1800000000000000 1100 0100 01000000  # 24: LED_CAPSL on: another event type
1900000000000000 1900000000000000 0000 0000 00000000  # 25: SYN_REPORT
1a00000000000000 1a00000000000000 0100 b800 01000000  # 26: => deafen press
1b00000000000000 1b00000000000000 0100 b800 02000000  # 27: deafen auto-repeat: ignored
1c00000000000000 1c00000000000000 0100 b800 00000000  # 28: => deafen release
1d00000000000000 1d00000000000000 0000 0000 00000000  # 29: SYN_REPORT
1e00000000000000 1e00000000000000 0200 6100 01000000  # 30: EV_REL with the talk key's code and value 1: not a key event
1f00000000000000 1f00000000000000 0100 0061 01000000  # 31: key code 0x6100, the talk code byte-swapped: another key
2000000000000000 2000000000000000 0100 6100 03000000  # 32: talk with value 3, which is no press, release or repeat: ignored
2100000000000000 2100000000000000 0100 2a00 00000000  # 33: KEY_LEFTSHIFT release: another key
2200000000000000 2200000000000000 0000 0000 00000000  # 34: SYN_REPORT
0100610001000000 0100610001000000 0000 0000 00000000  # 35: SYN_REPORT whose time bytes spell a talk press (01 00 61 00 01 00 00 00), twice
2400000000000000 2400000000000000 0100 6100 00000000  # 36: => talk release
2500000000000000 2500000000000000 0000 0000 00000000  # 37: SYN_REPORT
2600000000000000 2600000000000000 0000 0300 00000000  # 38: SYN_DROPPED: events were lost, so the talk key is reported released
2700000000000000 2700000000000000 0100 1c00 01000000  # 39: KEY_ENTER press: another key
2800000000000000 2800000000000000 0100 1c00 00000000  # 40: KEY_ENTER release: another key
2900000000000000 2900000000000000 0000 0000 00000000  # 41: SYN_REPORT
